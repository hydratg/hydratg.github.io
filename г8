<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HYDRA BLACK · пиццерия</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --neon: #00ffa3;
      --neon-dim: #00cc82;
      --accent: #00e0ff;
      --bg: #050608;
      --bg-2: #0a0d10;
      --card: #0d1114;
      --border: #1a2025;
      --border-hover: rgba(0, 255, 163, 0.5);
      --text: #e8f0f0;
      --text-dim: #6b7a80;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
      min-height: 100vh;
      overflow-x: hidden;
      background-image:
        linear-gradient(rgba(0, 255, 163, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 255, 163, 0.03) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    .container {
      max-width: 1300px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ========== ШАПКА ========== */
    header {
      padding: 16px 0;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(5, 6, 8, 0.85);
      backdrop-filter: blur(16px);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 900;
      font-size: 22px;
      letter-spacing: -0.5px;
      text-transform: uppercase;
      user-select: none;
    }

    .logo-mark {
      width: 36px;
      height: 36px;
      border: 2px solid var(--neon);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      box-shadow: 0 0 20px rgba(0, 255, 163, 0.4), inset 0 0 12px rgba(0, 255, 163, 0.15);
      animation: pulseGlow 3s ease-in-out infinite;
    }

    .logo-mark::before {
      content: "H";
      font-size: 18px;
      font-weight: 900;
      color: var(--neon);
      text-shadow: 0 0 12px var(--neon);
    }

    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 20px rgba(0, 255, 163, 0.4), inset 0 0 12px rgba(0, 255, 163, 0.15); }
      50% { box-shadow: 0 0 32px rgba(0, 255, 163, 0.7), inset 0 0 16px rgba(0, 255, 163, 0.25); }
    }

    .logo-text .brand {
      color: var(--neon);
      text-shadow: 0 0 14px rgba(0, 255, 163, 0.6);
    }

    .logo-text .sub {
      color: var(--text);
      font-weight: 300;
      letter-spacing: 3px;
      font-size: 18px;
      margin-left: 4px;
    }

    nav { display: flex; gap: 28px; font-size: 15px; font-weight: 500; }

    nav a {
      color: var(--text-dim);
      text-decoration: none;
      transition: color 0.2s, text-shadow 0.2s;
      position: relative;
      padding: 4px 0;
    }

    nav a:hover {
      color: var(--neon);
      text-shadow: 0 0 10px rgba(0, 255, 163, 0.6);
    }

    .cart-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      background: transparent;
      border: 1.5px solid var(--neon);
      color: var(--neon);
      font-weight: 700;
      font-size: 14px;
      padding: 10px 20px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.25s;
      font-family: inherit;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      box-shadow: 0 0 16px rgba(0, 255, 163, 0.15);
    }

    .cart-btn:hover {
      background: rgba(0, 255, 163, 0.1);
      box-shadow: 0 0 26px rgba(0, 255, 163, 0.5);
      transform: translateY(-1px);
    }

    .cart-btn.bump { animation: bump 0.35s ease; }

    @keyframes bump {
      0% { transform: scale(1); }
      40% { transform: scale(1.1); }
      100% { transform: scale(1); }
    }

    /* ========== HERO ========== */
    .hero {
      padding: 80px 0 60px;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      top: 50%;
      right: -10%;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle, rgba(0, 255, 163, 0.12) 0%, transparent 60%);
      transform: translateY(-50%);
      pointer-events: none;
      z-index: 0;
    }

    .hero-inner {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .hero-label {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--neon);
      margin-bottom: 24px;
      padding: 6px 0;
    }

    .hero-label::before {
      content: "";
      width: 40px;
      height: 2px;
      background: var(--neon);
      box-shadow: 0 0 10px var(--neon);
    }

    .hero h1 {
      font-size: 72px;
      font-weight: 900;
      line-height: 0.98;
      letter-spacing: -3px;
      color: var(--text);
      margin-bottom: 24px;
    }

    .hero h1 .accent {
      color: var(--neon);
      text-shadow: 0 0 30px rgba(0, 255, 163, 0.5);
      font-style: italic;
    }

    .hero p {
      color: var(--text-dim);
      font-size: 18px;
      max-width: 540px;
      margin-bottom: 34px;
      line-height: 1.6;
    }

    .hero-cta {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
    }

    .btn-hero {
      padding: 15px 30px;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      transition: all 0.25s;
      border: none;
    }

    .btn-hero.primary {
      background: var(--neon);
      color: #050608;
      box-shadow: 0 0 24px rgba(0, 255, 163, 0.5);
    }

    .btn-hero.primary:hover {
      box-shadow: 0 0 40px rgba(0, 255, 163, 0.8);
      transform: translateY(-2px);
    }

    .btn-hero.ghost {
      background: transparent;
      color: var(--text);
      border: 1.5px solid var(--border);
    }

    .btn-hero.ghost:hover {
      border-color: var(--neon);
      color: var(--neon);
    }

    /* Правая часть hero — «терминал» со статистикой */
    .hero-visual {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      position: relative;
      box-shadow: 0 30px 60px -20px black;
    }

    .hero-visual::before {
      content: "";
      position: absolute;
      inset: -1px;
      border-radius: 16px;
      padding: 1px;
      background: linear-gradient(135deg, var(--neon), transparent 40%, transparent 60%, var(--accent));
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
      opacity: 0.6;
    }

    .terminal-header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 22px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
    }

    .terminal-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #2a2a2a;
    }

    .terminal-dot.red { background: #ff5f57; }
    .terminal-dot.yellow { background: #ffbd2e; }
    .terminal-dot.green { background: var(--neon); box-shadow: 0 0 8px var(--neon); }

    .terminal-title {
      margin-left: auto;
      font-size: 12px;
      color: var(--text-dim);
      font-family: 'Courier New', monospace;
    }

    .stat-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 14px 0;
      border-bottom: 1px dashed rgba(255, 255, 255, 0.06);
    }

    .stat-row:last-child { border-bottom: none; }

    .stat-row .label {
      font-size: 14px;
      color: var(--text-dim);
      font-family: 'Courier New', monospace;
    }

    .stat-row .value {
      font-size: 20px;
      font-weight: 800;
      color: var(--neon);
      text-shadow: 0 0 12px rgba(0, 255, 163, 0.4);
      font-family: 'Courier New', monospace;
    }

    /* ========== СЕКЦИИ ========== */
    .menu-section {
      padding: 60px 0;
      scroll-margin-top: 90px;
    }

    .section-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 42px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border);
    }

    .section-head-left { display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; }

    .section-num {
      font-size: 14px;
      font-weight: 700;
      color: var(--neon);
      letter-spacing: 3px;
      font-family: 'Courier New', monospace;
    }

    .section-title {
      font-size: 42px;
      font-weight: 900;
      letter-spacing: -1.5px;
      color: var(--text);
      text-transform: uppercase;
    }

    .section-sub {
      color: var(--text-dim);
      font-size: 14px;
      font-family: 'Courier New', monospace;
      letter-spacing: 1px;
    }

    /* ========== СЕТКА ========== */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
      gap: 24px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 0;
      overflow: hidden;
      transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    .card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--neon);
      box-shadow: 0 0 12px var(--neon);
      transition: width 0.4s ease;
      z-index: 3;
    }

    .card:hover::before { width: 100%; }

    .card:hover {
      transform: translateY(-6px);
      border-color: var(--border-hover);
      box-shadow: 0 24px 60px -20px rgba(0, 255, 163, 0.25);
    }

    .card-visual {
      width: 100%;
      aspect-ratio: 4 / 3;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 120px;
      position: relative;
      overflow: hidden;
      border-bottom: 1px solid var(--border);
    }

    .card-visual::after {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(0, 255, 163, 0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 255, 163, 0.06) 1px, transparent 1px);
      background-size: 24px 24px;
      pointer-events: none;
      opacity: 0.5;
    }

    .card[data-type="pizza-pepperoni"] .card-visual { background: linear-gradient(135deg, #1a0d08 0%, #2d1208 100%); }
    .card[data-type="pizza-margherita"] .card-visual { background: linear-gradient(135deg, #0d1a08 0%, #142d08 100%); }
    .card[data-type="drink-cola"] .card-visual { background: linear-gradient(135deg, #1a0808 0%, #2d0a0a 100%); }
    .card[data-type="drink-orange"] .card-visual { background: linear-gradient(135deg, #1a1108 0%, #2d1e08 100%); }

    .card[data-type="pizza-pepperoni"] .card-visual::before,
    .card[data-type="pizza-margherita"] .card-visual::before { content: "🍕"; filter: drop-shadow(0 10px 20px black); position: relative; z-index: 2; }
    .card[data-type="drink-cola"] .card-visual::before { content: "🥤"; filter: drop-shadow(0 10px 20px black); position: relative; z-index: 2; }
    .card[data-type="drink-orange"] .card-visual::before { content: "🧃"; filter: drop-shadow(0 10px 20px black); position: relative; z-index: 2; }

    .card-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      z-index: 3;
      background: rgba(5, 6, 8, 0.85);
      border: 1px solid var(--neon);
      color: var(--neon);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 5px 12px;
      border-radius: 4px;
      font-family: 'Courier New', monospace;
    }

    .card-body { padding: 24px 24px 22px; display: flex; flex-direction: column; flex: 1; }

    .card h3 {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -0.5px;
      margin-bottom: 8px;
      color: var(--text);
      text-transform: uppercase;
    }

    .card-desc {
      color: var(--text-dim);
      font-size: 14px;
      margin-bottom: 20px;
      line-height: 1.6;
      flex-grow: 1;
    }

    .price-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
      padding-top: 16px;
      border-top: 1px dashed var(--border);
    }

    .price {
      font-size: 30px;
      font-weight: 900;
      color: var(--neon);
      text-shadow: 0 0 18px rgba(0, 255, 163, 0.4);
      letter-spacing: -1px;
      font-family: 'Courier New', monospace;
    }

    .price small {
      font-size: 15px;
      font-weight: 500;
      color: var(--text-dim);
      margin-left: 4px;
      text-shadow: none;
    }

    .weight {
      color: var(--text-dim);
      font-size: 12px;
      font-family: 'Courier New', monospace;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .card-actions { display: flex; gap: 10px; }

    .btn-primary {
      flex: 1;
      background: transparent;
      border: 1.5px solid var(--neon);
      color: var(--neon);
      font-weight: 800;
      padding: 14px 18px;
      border-radius: 8px;
      font-size: 13px;
      cursor: pointer;
      font-family: inherit;
      letter-spacing: 1px;
      text-transform: uppercase;
      transition: all 0.25s;
      position: relative;
      overflow: hidden;
    }

    .btn-primary::after {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--neon);
      transform: translateX(-101%);
      transition: transform 0.3s ease;
      z-index: -1;
    }

    .btn-primary:hover {
      color: #050608;
      box-shadow: 0 0 24px rgba(0, 255, 163, 0.6);
    }

    .btn-primary:hover::after { transform: translateX(0); }

    .btn-primary:active { transform: scale(0.97); }

    .btn-outline {
      background: transparent;
      border: 1.5px solid var(--border);
      color: var(--text-dim);
      font-weight: 600;
      padding: 14px 18px;
      border-radius: 8px;
      font-size: 13px;
      cursor: default;
      font-family: inherit;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    /* ========== О НАС ========== */
    .about-section {
      padding: 60px 0;
      scroll-margin-top: 90px;
    }

    .about-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 56px 48px;
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 56px;
      align-items: center;
      position: relative;
      overflow: hidden;
    }

    .about-card::before {
      content: "BEST IN CITY";
      position: absolute;
      top: 24px;
      right: -40px;
      font-size: 120px;
      font-weight: 900;
      color: rgba(0, 255, 163, 0.03);
      letter-spacing: 4px;
      pointer-events: none;
      transform: rotate(-6deg);
      white-space: nowrap;
    }

    .about-text { position: relative; z-index: 1; }

    .about-text h2 {
      font-size: 44px;
      font-weight: 900;
      letter-spacing: -2px;
      margin-bottom: 20px;
      color: var(--text);
      line-height: 1.05;
      text-transform: uppercase;
    }

    .about-text h2 .accent {
      color: var(--neon);
      text-shadow: 0 0 24px rgba(0, 255, 163, 0.5);
      display: block;
    }

    .about-text p {
      color: var(--text-dim);
      font-size: 16px;
      line-height: 1.75;
      margin-bottom: 16px;
      max-width: 560px;
    }

    .about-features {
      display: flex;
      flex-direction: column;
      gap: 14px;
      position: relative;
      z-index: 1;
    }

    .feature {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 18px 22px;
      background: rgba(0, 255, 163, 0.03);
      border: 1px solid var(--border);
      border-left: 3px solid var(--neon);
      border-radius: 8px;
      transition: background 0.2s, transform 0.2s;
    }

    .feature:hover {
      background: rgba(0, 255, 163, 0.08);
      transform: translateX(6px);
    }

    .feature-icon { font-size: 26px; }
    .feature span { font-weight: 700; font-size: 14px; color: var(--text); letter-spacing: 0.5px; text-transform: uppercase; }

    /* ========== INFO BAR ========== */
    .info-bar {
      margin: 40px 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
    }

    .info-item {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 26px 24px;
      display: flex;
      align-items: center;
      gap: 18px;
      transition: border-color 0.2s, transform 0.2s;
    }

    .info-item:hover {
      border-color: var(--border-hover);
      transform: translateY(-4px);
    }

    .info-icon { font-size: 32px; }
    .info-text h4 { font-size: 16px; font-weight: 800; color: var(--text); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
    .info-text p { color: var(--text-dim); font-size: 13px; font-family: 'Courier New', monospace; }

    /* ========== ФУТЕР ========== */
    footer {
      padding: 40px 0 50px;
      border-top: 1px solid var(--border);
      color: var(--text-dim);
      font-size: 13px;
    }

    .footer-inner {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      font-family: 'Courier New', monospace;
    }

    .footer-links { display: flex; gap: 28px; flex-wrap: wrap; }
    .footer-links a { color: var(--text-dim); text-decoration: none; transition: color 0.2s; letter-spacing: 1px; }
    .footer-links a:hover { color: var(--neon); }

    /* ========== КОРЗИНА ========== */
    .cart-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.85);
      z-index: 200;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s, visibility 0.3s;
    }

    .cart-overlay.open { opacity: 1; visibility: visible; }

    .cart-panel {
      position: fixed;
      top: 0;
      right: 0;
      height: 100%;
      width: 100%;
      max-width: 480px;
      background: var(--bg-2);
      border-left: 1px solid var(--border);
      z-index: 210;
      transform: translateX(100%);
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
      box-shadow: -20px 0 60px rgba(0, 255, 163, 0.1);
    }

    .cart-panel.open { transform: translateX(0); }

    .cart-header {
      padding: 24px 26px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }

    .cart-header h2 {
      font-size: 22px;
      font-weight: 900;
      letter-spacing: -0.5px;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 12px;
      text-transform: uppercase;
    }

    .cart-header h2 .accent { color: var(--neon); text-shadow: 0 0 14px rgba(0, 255, 163, 0.5); }

    .cart-count {
      background: rgba(0, 255, 163, 0.1);
      border: 1px solid var(--neon);
      color: var(--neon);
      font-size: 12px;
      font-weight: 800;
      padding: 4px 12px;
      border-radius: 4px;
      font-family: 'Courier New', monospace;
    }

    .cart-close {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text);
      width: 38px;
      height: 38px;
      border-radius: 8px;
      font-size: 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
      line-height: 1;
      font-family: inherit;
    }

    .cart-close:hover {
      border-color: #ff4a4a;
      color: #ff4a4a;
      box-shadow: 0 0 16px rgba(255, 74, 74, 0.4);
    }

    .cart-body { flex: 1; overflow-y: auto; padding: 8px 22px; }

    .cart-empty { text-align: center; padding: 80px 20px; }
    .cart-empty-icon { font-size: 72px; margin-bottom: 20px; opacity: 0.4; }
    .cart-empty p { font-size: 17px; color: var(--text-dim); margin-bottom: 8px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
    .cart-empty small { color: #444; font-size: 13px; font-family: 'Courier New', monospace; }

    .cart-item {
      display: flex;
      gap: 14px;
      padding: 20px 0;
      border-bottom: 1px solid var(--border);
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateX(12px); }
      to { opacity: 1; transform: translateX(0); }
    }

    .cart-item-visual {
      width: 72px;
      height: 72px;
      border-radius: 10px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      border: 1px solid var(--border);
      position: relative;
      overflow: hidden;
    }

